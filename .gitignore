# ---- Unity generated ----
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# ---- Visual Studio / Rider / VS Code ----
.vs/
.idea/
.vscode/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Build artifacts ----
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties

# ---- Addressables / Burst ----
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ---- Claude Code ----
# 스킬은 커밋한다. 머신별 로컬 설정만 제외.
.claude/settings.local.json

# Unity가 비정상 종료 시 남기는 씬 복구본. 이미 저장된 씬의 사본이라 커밋할 것이 없다.
/[Aa]ssets/_Recovery/
/[Aa]ssets/_Recovery.meta
